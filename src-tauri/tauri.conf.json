{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub 仓库管理工具",
  "version": "1.0.0",
  "identifier": "com.gitmng.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w web -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitHub 仓库管理工具",
        "width": 820,
        "height": 800,
        "minWidth": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
